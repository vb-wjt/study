4239-9d3d-30b55b05aaa5","title":"io-threads","attributedTitle":[{"text":"io-threads"}],"children":{"attached":[{"id":"0d9da0e1-a3c4-4f38-a49a-245d53aad02d","title":"主要执行非阻塞任务。默认每个CPU核心一个线程，不可以设置过大，否则会报错：打开文件数过多","attributedTitle":[{"text":"主要执行非阻塞任务。默认每个CPU核心一个线程，不可以设置过大，否则会报错：打开文件数过多"}]}]}},{"id":"f3e19530-383d-4f25-bd94-5d7db9a0e15b","title":"buffer-Size","attributedTitle":[{"text":"buffer-Size"}],"children":{"attached":[{"id":"8972279e-f1e7-4f61-b90b-d84e37dac46e","title":"每块buffer的空间大小，越小空间被利用越充分，不要设置太大。可以 1024kb","attributedTitle":[{"text":"每块buffer的空间大小，越小空间被利用越充分，不要设置太大。可以 1024kb"}]}]}},{"id":"c16be1cb-1b64-43e3-b383-c450e0ea4bca","title":"direct-buffers","attributedTitle":[{"text":"direct-buffers"}],"children":{"attached":[{"id":"5a611247-bf25-419c-9e15-291769e6364c","title":"可以设置为 true， 使用直接内存（堆外内存）来存储缓冲区，减少垃圾回收的开销","attributedTitle":[{"text":"可以设置为 true， 使用直接内存（堆外内存）来存储缓冲区，减少垃圾回收的开销"}]}]}},{"id":"94cde20a-a8eb-4768-9e7a-f9a2d8ee1940","title":"no-request-timeout","attributedTitle":[{"text":"no-request-timeout"}],"children":{"attached":[{"id":"632e8f37-56fb-432c-b5f0-611ef55e1841","title":"连接在不处理请求的情况下闲置的时间","attributedTitle":[{"text":"连接在不处理请求的情况下闲置的时间"}]}]}},{"id":"93c449a8-d0b8-4980-b60c-d5ba0d7308c4","title":"开启HTTP/2","attributedTitle":[{"text":"开启HTTP/2"}],"children":{"attached":[{"id":"8132e9d5-0ffa-4c3d-afcd-e5e4d45e97b6","title":"启用 HTTP2，提高网络传输效率","attributedTitle":[{"text":"启用 HTTP2，提高网络传输效率"}]},{"id":"18888ffb-d39d-4216-9bea-289fb0b4ed59","title":"server.undertow.enabled=true","attributedTitle":[{"text":"server.undertow.enabled=true"}]}]}},{"id":"4a771afd-8037-4464-a779-b50cb4f110f1","title":"示例：","attributedTitle":[{"text":"示例："}],"children":{"attached":[{"id":"d2d94d22-d564-4518-ae98-4a5d6510c2d0","title":"# 增加IO线程数\nserver.undertow.io-threads=16\n \n# 增加工作线程数\nserver.undertow.worker-threads=256\n \n# 设置缓冲区大小\nserver.undertow.buffer-size=1024\n \n# 使用直接内存\nserver.undertow.direct-buffers=true\n\n# 连接在不处理请求的情况下闲置的时间\nserver.undertow.no-request-timeout = 60000\n \n# 启用HTTP/2\nserver.undertow.enabled=true","attributedTitle":[{"text":"# 增加IO线程数\nserver.undertow.io-threads=16\n \n# 增加工作线程数\nserver.undertow.worker-threads=256\n \n# 设置缓冲区大小\nserver.undertow.buffer-size=1024\n \n# 使用直接内存\nserver.undertow.direct-buffers=true\n\n# 连接在不处理请求的情况下闲置的时间\nserver.undertow.no-request-timeout = 60000\n \n# 启用HTTP/2\nserver.undertow.enabled=true"}]}]}}]}}]},"style":{"id":"3c2c2fa8-721e-4a06-8811-4b7fc20b0505","properties":{"svg:fill":"#FFFFFFFF","border-line-width":"2pt","border-line-pattern":"handdrawn-solid"}}},"title":"思维导图","topicOverlapping":"overlap","extensions":[{"provider":"org.xmind.ui.skeleton.structure.style","content":{"centralTopic":"org.xmind.ui.map.clockwise"}}],"theme":{"map":{"id":"652fddac-8e87-4002-84b3-b864fba66fb8","properties":{"svg:fill":"#ffffff","multi-line-colors":"#F9423A #F6A04D #F3D321 #00BC7B #486AFF #4D49BE","color-list":"#000229 #1F2766 #52CC83 #4D86DB #99142F #245570","line-tapered":"none"}},"centralTopic":{"id":"aab2c984-9750-43cd-8075-3003aa7b1f14","properties":{"fo:font-family":"NeverMind","fo:font-size":"30pt","fo:font-weight":"500","fo:font-style":"normal","fo:color":"inherited","fo:text-transform":"manual","fo:text-decoration":"none","fo:text-align":"center","svg:fill":"#000229","fill-pattern":"solid","line-width":"3pt","line-color":"#000229","line-pattern":"solid","border-line-color":"inherited","border-line-width":"0pt","border-line-pattern":"inherited","shape-class":"org.xmind.topicShape.roundedRect","line-class":"org.xmind.branchConnection.curve","arrow-end-class":"org.xmind.arrowShape.none","alignment-by-level":"inactived"}},"mainTopic":{"id":"f917278d-5360-47fe-8121-49529cb7e764","properties":{"fo:font-family":"NeverMind","fo:font-size":"18pt","fo:font-weight":"500","fo:font-style":"normal","fo:color":"inherited","fo:text-transform":"manual","fo:text-decoration":"none","fo:text-align":"left","svg:fill":"inherited","fill-pattern":"solid","line-width":"2pt","line-color":"inherited",